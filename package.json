{
  "name": "nfl-pickem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10.9.7 <11"
  },
  "overrides": {
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local WRANGLER_SEND_METRICS=false vite --host 127.0.0.1",
    "build": "CLOUDFLARE_ENV=local WRANGLER_SEND_METRICS=false vite build",
    "build:staging": "CLOUDFLARE_ENV=staging WRANGLER_SEND_METRICS=false vite build",
    "build:production": "CLOUDFLARE_ENV=production WRANGLER_SEND_METRICS=false vite build",
    "preview": "WRANGLER_SEND_METRICS=false vite preview --host 127.0.0.1",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip",
    "metrics": "node scripts/quality.mjs",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "WRANGLER_SEND_METRICS=false vitest run",
    "test:unit": "WRANGLER_SEND_METRICS=false vitest run --project unit",
    "test:workers": "WRANGLER_SEND_METRICS=false vitest run --project workers",
    "test:client": "WRANGLER_SEND_METRICS=false vitest run --project client",
    "rehearsal:serve": "node scripts/rehearsal/serve.mjs",
    "test:e2e": "playwright test",
    "db:migrate:local": "WRANGLER_SEND_METRICS=false wrangler d1 migrations apply DB --local --env local --config wrangler.jsonc",
    "deploy:dry-run": "npm run build:staging && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy": "node scripts/cloudflare.mjs"
  },
  "dependencies": {
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/vitest-plugin": "1.1.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "miniflare": "5.20260910.0-alpha",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
