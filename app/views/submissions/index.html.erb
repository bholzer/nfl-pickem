<div class="py-8">
  <div class="max-w-6xl mx-auto px-4">
    <div class="bg-white rounded-lg shadow-xl p-6 sm:p-8 mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-gray-800 text-center">NFL Pick'em Standings</h1>
      <p class="text-xl text-gray-600 text-center">Week <%= @week %></p>
    </div>

    <% if @standings && @standings.any? %>
      <div class="bg-white shadow-xl rounded-lg overflow-hidden">
        <table class="w-full">
          <thead class="bg-gray-800 text-white">
            <tr>
              <th class="px-6 py-4 text-left">Rank</th>
              <th class="px-6 py-4 text-left">Player</th>
              <th class="px-6 py-4 text-center">Correct Picks</th>
              <th class="px-6 py-4 text-center">Total Picks</th>
              <th class="px-6 py-4 text-center">Tiebreaker</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @standings.each_with_index do |standing, index| %>
              <% rank = index + 1 %>
              <% medal = rank == 1 ? "🥇" : (rank == 2 ? "🥈" : (rank == 3 ? "🥉" : "")) %>
              <tr class="<%= rank <= 3 ? 'bg-yellow-50' : 'hover:bg-gray-50' %>">
                <td class="px-6 py-4 font-bold text-lg">
                  <%= medal %> #<%= rank %>
                </td>
                <td class="px-6 py-4 font-semibold">
                  <%= standing[:username] %>
                </td>
                <td class="px-6 py-4 text-center text-lg font-bold text-green-600">
                  <%= standing[:correct_picks] %>
                </td>
                <td class="px-6 py-4 text-center text-gray-600">
                  <%= standing[:total_picks] %>
                </td>
                <td class="px-6 py-4 text-center text-gray-600">
                  <%= standing[:tiebreaker] %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow-xl p-6 sm:p-8">
        <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded text-center">
          No submissions yet for Week <%= @week %>.
        </div>
      </div>
    <% end %>
  </div>
</div>
