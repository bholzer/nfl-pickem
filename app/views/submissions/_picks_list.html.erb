<!-- Games List -->
<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden mb-4 sm:mb-6">
  <div class="divide-y divide-gray-100 dark:divide-gray-800">
    <% picks.each do |pick| %>
      <% game = pick[:game] %>
      <% next unless game %>
      <% is_correct = pick[:correct] %>
      <% is_completed = pick[:winning_team_id].present? %>
      <% selected_team = [game[:away_team], game[:home_team]].find { |t| t[:id] == pick[:selected_team_id] } %>

      <div class="px-3 sm:px-4 py-3 <%= is_correct ? 'bg-green-50 dark:bg-green-950' : (is_completed ? 'bg-red-50 dark:bg-red-950' : '') %>">
        <!-- Time and Status Row -->
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs text-gray-500 dark:text-gray-400">
            <%= game[:date].strftime("%a %l:%M %p") %>
          </div>
          <div class="flex items-center gap-1.5">
            <% if game[:status] == "STATUS_IN_PROGRESS" %>
              <!-- Game Status -->
              <span class="px-1.5 py-0.5 bg-blue-600 dark:bg-blue-700 text-white text-xs font-medium rounded">
                <%= game[:status_detail] %>
              </span>
            <% end %>
            <% if is_completed %>
              <!-- Result Icon -->
              <% if is_correct %>
                <span class="text-green-600 dark:text-green-400 text-lg">✓</span>
              <% else %>
                <span class="text-red-600 dark:text-red-400 text-lg">✗</span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Scoreboard Row -->
        <div class="flex items-center gap-3">
          <!-- Away Team -->
          <div class="flex-1 flex items-center gap-1.5 justify-end">
            <!-- Win indicator -->
            <% if pick[:winning_team_id] == game[:away_team][:id] %>
              <span class="text-green-600 dark:text-green-400 text-sm flex-shrink-0">✓</span>
            <% end %>
            <% if pick[:selected_team_id] == game[:away_team][:id] %>
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 rounded flex items-center gap-1.5">
                <img src="<%= game[:away_team][:logo] %>" alt="<%= game[:away_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
                <span class="text-sm font-semibold"><%= game[:away_team][:abbreviation] %></span>
                <% if game[:away_team][:score] %>
                  <span class="text-base font-bold"><%= game[:away_team][:score] %></span>
                <% end %>
              </span>
            <% else %>
              <img src="<%= game[:away_team][:logo] %>" alt="<%= game[:away_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
              <span class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= game[:away_team][:abbreviation] %></span>
              <% if game[:away_team][:score] %>
                <span class="text-base font-bold text-gray-900 dark:text-gray-100"><%= game[:away_team][:score] %></span>
              <% end %>
            <% end %>
          </div>

          <!-- Divider -->
          <div class="flex-shrink-0">
            <span class="text-gray-400 dark:text-gray-500 text-xs font-medium">@</span>
          </div>

          <!-- Home Team -->
          <div class="flex-1 flex items-center gap-1.5 justify-start">
            <% if pick[:selected_team_id] == game[:home_team][:id] %>
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 rounded flex items-center gap-1.5">
                <% if game[:home_team][:score] %>
                  <span class="text-base font-bold"><%= game[:home_team][:score] %></span>
                <% end %>
                <span class="text-sm font-semibold"><%= game[:home_team][:abbreviation] %></span>
                <img src="<%= game[:home_team][:logo] %>" alt="<%= game[:home_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
              </span>
            <% else %>
              <% if game[:home_team][:score] %>
                <span class="text-base font-bold text-gray-900 dark:text-gray-100"><%= game[:home_team][:score] %></span>
              <% end %>
              <span class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= game[:home_team][:abbreviation] %></span>
              <img src="<%= game[:home_team][:logo] %>" alt="<%= game[:home_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
            <% end %>
            <!-- Win indicator -->
            <% if pick[:winning_team_id] == game[:home_team][:id] %>
              <span class="text-green-600 dark:text-green-400 text-sm flex-shrink-0">✓</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
