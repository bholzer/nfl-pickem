<div class="py-8">
  <div class="max-w-5xl mx-auto px-4">
    <div class="bg-white rounded-lg shadow-xl p-6 sm:p-8 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-800">NFL Pick'em - Week <%= @week %></h1>
      <p class="text-gray-600 mb-4">
        Welcome, <strong><%= @token_data[:username] %></strong>
      </p>

      <% if @games_locked %>
        <% if @submission.persisted? %>
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <strong>Locked!</strong> You cannot edit your picks after games have started.
          </div>
        <% else %>
          <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
            <strong>Late submission:</strong> Some games have started. You can only pick for games that haven't kicked off yet.
          </div>
        <% end %>
      <% elsif @earliest_game_time %>
        <div class="bg-blue-50 border border-blue-300 text-blue-700 px-4 py-3 rounded">
          Picks lock at: <strong><%= @earliest_game_time.strftime("%A, %B %d at %l:%M %p %Z") %></strong>
        </div>
      <% end %>
    </div>

    <% if @scoreboard.games&.any? %>
      <%= form_with model: @submission do |f| %>
        <%= hidden_field_tag :token, params[:token] %>

        <div class="bg-white rounded-lg shadow-xl p-6 sm:p-8">
          <!-- Games by Day -->
          <% games_by_day = @scoreboard.games.group_by { |game| game[:date].to_date } %>
          <% games_by_day.sort.each_with_index do |(date, games), index| %>
            <!-- Day Separator -->
            <% if index > 0 %>
              <div class="border-t-2 border-gray-200 my-6 sm:my-8"></div>
            <% end %>

            <h2 class="text-xl sm:text-2xl font-bold mb-4 text-gray-800">
              <%= date.strftime("%A, %B %d") %>
            </h2>

            <div class="space-y-2 sm:space-y-3 mb-6">
              <% games.each do |game| %>
                <% existing_pick_team_id = @submission.picks[game[:competition_id]] if @submission.picks.present? %>
                <% game_started = game[:status] != "STATUS_SCHEDULED" %>
                <% pick_disabled = game_started || (@submission.persisted? && @games_locked) %>

                <div class="border-2 <%= game_started ? 'border-gray-300 bg-gray-50' : 'border-gray-200' %> hover:border-indigo-300 rounded-lg p-3 sm:p-4 transition-colors">
                  <!-- Game Time & Status -->
                  <div class="flex items-center justify-between mb-2 text-xs sm:text-sm">
                    <div class="text-gray-500 font-medium">
                      <%= game[:date].strftime("%l:%M %p %Z") %>
                    </div>
                    <% if game_started %>
                      <span class="px-2 py-1 bg-red-100 text-red-700 text-xs rounded font-medium">
                        <%= game[:status_detail] %>
                      </span>
                    <% end %>
                  </div>

                  <!-- Teams -->
                  <div class="flex items-center justify-center gap-2 sm:gap-3">
                    <!-- Away Team (Left) -->
                    <div class="flex items-center justify-end gap-1 sm:gap-2 flex-1">
                      <label for="away_<%= game[:competition_id] %>" class="cursor-pointer font-medium text-gray-800 text-xs sm:text-sm text-right hover:text-indigo-600 transition-colors">
                        <% if game_started && game[:away_team][:score] %>
                          <span class="mr-1 text-lg font-bold"><%= game[:away_team][:score] %></span>
                        <% end %>
                        <%= game[:away_team][:abbreviation] %>
                      </label>
                      <img src="<%= game[:away_team][:logo] %>"
                           alt="<%= game[:away_team][:name] %>"
                           class="w-6 h-6 sm:w-8 sm:h-8 object-contain flex-shrink-0">
                      <div class="relative flex items-center">
                        <%= radio_button_tag "submission[picks][#{game[:competition_id]}]",
                                             game[:away_team][:id],
                                             existing_pick_team_id == game[:away_team][:id],
                                             disabled: pick_disabled,
                                             id: "away_#{game[:competition_id]}",
                                             class: "appearance-none w-5 h-5 sm:w-6 sm:h-6 border-2 rounded border-gray-300 cursor-pointer transition-all
                                                     checked:bg-indigo-600 checked:border-indigo-600
                                                     hover:border-indigo-400
                                                     disabled:bg-gray-200 disabled:border-gray-300 disabled:cursor-not-allowed
                                                     focus:ring-2 focus:ring-indigo-200 focus:ring-offset-1",
                                             required: true %>
                        <svg class="absolute inset-0 w-5 h-5 sm:w-6 sm:h-6 text-white pointer-events-none transition-opacity"
                             style="<%= existing_pick_team_id == game[:away_team][:id] ? 'opacity: 1;' : 'opacity: 0;' %>"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                    </div>

                    <!-- Divider -->
                    <div class="px-2 text-gray-400 font-semibold text-sm sm:text-base flex-shrink-0">@</div>

                    <!-- Home Team (Right) -->
                    <div class="flex items-center justify-start gap-1 sm:gap-2 flex-1">
                      <div class="relative flex items-center">
                        <%= radio_button_tag "submission[picks][#{game[:competition_id]}]",
                                             game[:home_team][:id],
                                             existing_pick_team_id == game[:home_team][:id],
                                             disabled: pick_disabled,
                                             id: "home_#{game[:competition_id]}",
                                             class: "appearance-none w-5 h-5 sm:w-6 sm:h-6 border-2 rounded border-gray-300 cursor-pointer transition-all
                                                     checked:bg-indigo-600 checked:border-indigo-600
                                                     hover:border-indigo-400
                                                     disabled:bg-gray-200 disabled:border-gray-300 disabled:cursor-not-allowed
                                                     focus:ring-2 focus:ring-indigo-200 focus:ring-offset-1",
                                             required: true %>
                        <svg class="absolute inset-0 w-5 h-5 sm:w-6 sm:h-6 text-white pointer-events-none transition-opacity"
                             style="<%= existing_pick_team_id == game[:home_team][:id] ? 'opacity: 1;' : 'opacity: 0;' %>"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                      <img src="<%= game[:home_team][:logo] %>"
                           alt="<%= game[:home_team][:name] %>"
                           class="w-6 h-6 sm:w-8 sm:h-8 object-contain flex-shrink-0">
                      <label for="home_<%= game[:competition_id] %>" class="cursor-pointer font-medium text-gray-800 text-xs sm:text-sm hover:text-indigo-600 transition-colors">
                        <%= game[:home_team][:abbreviation] %>
                        <% if game_started && game[:home_team][:score] %>
                          <span class="ml-1 text-lg font-bold"><%= game[:home_team][:score] %></span>
                        <% end %>
                      </label>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Tiebreaker Separator -->
          <div class="border-t-2 border-gray-200 my-6 sm:my-8"></div>

          <!-- Tiebreaker -->
          <div class="mb-6">
            <label class="block text-lg sm:text-xl font-bold mb-2 text-gray-800">
              Tiebreaker
            </label>
            <p class="text-sm text-gray-600 mb-4">
              Enter the total combined points you think will be scored in Monday Night Football.
            </p>
            <div class="flex items-center gap-2">
              <%= f.number_field :tiebreaker,
                                 min: 0,
                                 required: true,
                                 disabled: @submission.persisted? && @games_locked,
                                 class: "border-2 border-gray-300 rounded-lg px-4 py-2 w-24 text-lg font-medium focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-colors",
                                 placeholder: "0" %>
              <span class="text-gray-600 font-medium">total points</span>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit"
                  <%= "disabled" if @submission.persisted? && @games_locked %>
                  class="w-full py-4 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-bold text-lg rounded-lg hover:from-indigo-600 hover:to-purple-700 transition-all transform hover:scale-105 disabled:from-gray-400 disabled:to-gray-500 disabled:cursor-not-allowed disabled:transform-none">
            <%= @submission.persisted? ? "Update Picks" : "Submit Picks" %>
          </button>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white rounded-lg shadow-xl p-6 sm:p-8">
        <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
          No games available for Week <%= @week %>.
        </div>
      </div>
    <% end %>
  </div>
</div>

