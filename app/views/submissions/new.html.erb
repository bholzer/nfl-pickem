<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
    <!-- Header -->
    <div class="mb-4 sm:mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Make Your Picks</h1>
      <p class="text-sm text-gray-600 mt-1"><%= @current_user.discord_username %> • Week <%= @week %></p>
    </div>

    <!-- Alerts -->
    <% if @games_locked %>
      <% if @submission.persisted? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-4 sm:mb-6">
          <p class="text-sm text-red-800"><strong>Locked!</strong> You cannot edit your picks after games have started.</p>
        </div>
      <% else %>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mb-4 sm:mb-6">
          <p class="text-sm text-amber-800"><strong>Late submission:</strong> Some games have started. You can only pick for games that haven't kicked off yet.</p>
        </div>
      <% end %>
    <% elsif @earliest_game_time %>
      <div class="bg-sky-50 border border-sky-200 rounded-lg p-3 mb-4 sm:mb-6">
        <p class="text-sm text-sky-800">Picks lock at: <strong><%= @earliest_game_time.strftime("%A, %b %d at %l:%M %p %Z") %></strong></p>
      </div>
    <% end %>

    <% if @scoreboard.games&.any? %>
      <%= form_with model: @submission do |f| %>
        <%= hidden_field_tag :week, @week %>

        <!-- Games by Day -->
        <% games_by_day = @scoreboard.games.group_by { |game| game[:date].to_date } %>
        <% games_by_day.sort.each_with_index do |(date, games), index| %>
          <div class="mb-4 sm:mb-6">
            <!-- Day Header -->
            <h2 class="text-lg font-semibold text-gray-900 mb-3">
              <%= date.strftime("%A, %B %d") %>
            </h2>

            <!-- Games List -->
            <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
              <div class="divide-y divide-gray-100">
              <% games.each do |game| %>
                <% existing_pick_team_id = @submission.picks[game[:competition_id]] if @submission.picks.present? %>
                <% game_started = game[:status] != "STATUS_SCHEDULED" %>
                <% pick_disabled = game_started || (@submission.persisted? && @games_locked) %>

                <div class="px-3 sm:px-4 py-3 <%= game_started ? 'bg-gray-50' : '' %>">
                  <!-- Game Time & Status -->
                  <div class="flex items-center justify-between mb-2">
                    <div class="text-xs text-gray-500">
                      <%= game[:date].strftime("%l:%M %p") %>
                    </div>
                    <% if game_started %>
                      <span class="px-1.5 py-0.5 bg-red-100 text-red-700 text-xs font-medium rounded">
                        <%= game[:status_detail] %>
                      </span>
                    <% end %>
                  </div>

                  <!-- Teams -->
                  <div class="flex items-center justify-center gap-2">
                    <!-- Away Team (Left) -->
                    <div class="flex items-center justify-end gap-2 flex-1">
                      <label for="away_<%= game[:competition_id] %>" class="cursor-pointer text-sm font-medium text-gray-900 text-right hover:text-blue-600 transition-colors">
                        <% if game_started && game[:away_team][:score] %>
                          <span class="mr-1 font-semibold"><%= game[:away_team][:score] %></span>
                        <% end %>
                        <%= game[:away_team][:abbreviation] %>
                      </label>
                      <img src="<%= game[:away_team][:logo] %>"
                           alt="<%= game[:away_team][:name] %>"
                           class="w-6 h-6 object-contain flex-shrink-0">
                      <div class="relative flex items-center">
                        <%= radio_button_tag "submission[picks][#{game[:competition_id]}]",
                                             game[:away_team][:id],
                                             existing_pick_team_id == game[:away_team][:id],
                                             disabled: pick_disabled,
                                             id: "away_#{game[:competition_id]}",
                                             class: "w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed",
                                             required: true %>
                      </div>
                    </div>

                    <!-- Divider -->
                    <div class="px-1.5 text-gray-400 font-medium text-xs flex-shrink-0">@</div>

                    <!-- Home Team (Right) -->
                    <div class="flex items-center justify-start gap-2 flex-1">
                      <div class="relative flex items-center">
                        <%= radio_button_tag "submission[picks][#{game[:competition_id]}]",
                                             game[:home_team][:id],
                                             existing_pick_team_id == game[:home_team][:id],
                                             disabled: pick_disabled,
                                             id: "home_#{game[:competition_id]}",
                                             class: "w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed",
                                             required: true %>
                      </div>
                      <img src="<%= game[:home_team][:logo] %>"
                           alt="<%= game[:home_team][:name] %>"
                           class="w-6 h-6 object-contain flex-shrink-0">
                      <label for="home_<%= game[:competition_id] %>" class="cursor-pointer text-sm font-medium text-gray-900 hover:text-blue-600 transition-colors">
                        <%= game[:home_team][:abbreviation] %>
                        <% if game_started && game[:home_team][:score] %>
                          <span class="ml-1 font-semibold"><%= game[:home_team][:score] %></span>
                        <% end %>
                      </label>
                    </div>
                  </div>
                </div>
              <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Tiebreaker -->
        <div class="bg-white border border-gray-200 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6">
          <label class="block text-base font-semibold mb-2 text-gray-900">
            Tiebreaker
          </label>
          <p class="text-xs sm:text-sm text-gray-600 mb-3">
            Total combined points in Monday Night Football
          </p>
          <div class="flex items-center gap-2">
            <%= f.number_field :tiebreaker,
                               min: 0,
                               required: true,
                               disabled: @submission.persisted? && @games_locked,
                               class: "w-20 px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 disabled:bg-gray-100 disabled:cursor-not-allowed",
                               placeholder: "0" %>
            <span class="text-sm text-gray-600">points</span>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit"
                <%= "disabled" if @submission.persisted? && @games_locked %>
                class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed">
          <%= @submission.persisted? ? "Update Picks" : "Submit Picks" %>
        </button>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 sm:p-4 text-center">
        <p class="text-sm text-amber-800">No games available for Week <%= @week %></p>
      </div>
    <% end %>
  </div>
</div>

