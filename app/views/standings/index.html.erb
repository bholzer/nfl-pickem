<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
    <!-- Header -->
    <div class="mb-4 sm:mb-6">
      <div class="flex items-center gap-2 sm:gap-3">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Standings</h1>
        <span class="px-2 py-1 bg-gray-200 text-gray-700 text-sm font-semibold rounded">Week <%= @week %></span>
      </div>
    </div>

    <% if @standings && @standings.any? %>
      <!-- Leaderboard -->
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="divide-y divide-gray-100">
          <%
            current_rank = 1
            @standings.each_with_index do |standing, index|
              # Handle ties: if this person has fewer correct picks than previous, update rank
              if index > 0 && standing[:correct_picks] < @standings[index - 1][:correct_picks]
                current_rank = index + 1
              end
              is_podium = current_rank <= 3
          %>
            <div class="flex items-center justify-between px-3 sm:px-4 py-3 <%= is_podium ? 'bg-amber-50' : 'hover:bg-gray-50' %> transition-colors duration-150">
              <!-- Rank & Player -->
              <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
                <div class="flex-shrink-0 w-8 sm:w-10 text-center">
                  <% if is_podium %>
                    <span class="text-xl sm:text-2xl">
                      <%= current_rank == 1 ? '🥇' : (current_rank == 2 ? '🥈' : '🥉') %>
                    </span>
                  <% else %>
                    <span class="text-sm sm:text-base font-medium text-gray-500">#<%= current_rank %></span>
                  <% end %>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-sm sm:text-base font-semibold text-gray-900 truncate">
                    <%= standing[:user].discord_username %>
                  </p>
                </div>
              </div>

              <!-- Score -->
              <div class="flex-shrink-0 ml-2">
                <span class="text-lg sm:text-xl font-bold text-green-600">
                  <%= standing[:correct_picks] %>
                </span>
                <span class="text-xs sm:text-sm text-gray-500 ml-1">picks</span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 sm:p-4 text-center">
        <p class="text-sm text-amber-800">No submissions yet for Week <%= @week %></p>
      </div>
    <% end %>
  </div>
</div>
