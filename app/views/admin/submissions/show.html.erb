<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
    <!-- Header -->
    <div class="mb-4 sm:mb-6">
      <div class="flex items-center gap-2 sm:gap-3 mb-1">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Player Picks</h1>
        <span class="px-2 py-1 bg-gray-200 text-gray-700 text-sm font-semibold rounded">Week <%= @breakdown[:week] %></span>
      </div>
      <p class="text-sm text-gray-600">Admin • <%= @breakdown[:user] %></p>
    </div>

    <!-- Stats Summary -->
    <div class="bg-white border border-gray-200 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6">
      <div class="flex items-center justify-around divide-x divide-gray-200">
        <div class="flex-1 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-green-600"><%= @breakdown[:correct_picks] %></div>
          <div class="text-xs sm:text-sm text-gray-600 mt-1">Correct</div>
        </div>
        <div class="flex-1 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-gray-900"><%= @breakdown[:tiebreaker] %></div>
          <div class="text-xs sm:text-sm text-gray-600 mt-1">Tiebreaker</div>
        </div>
      </div>
    </div>

    <!-- Games List -->
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-4 sm:mb-6">
      <div class="divide-y divide-gray-100">
        <% @breakdown[:picks].each do |pick| %>
          <% game = pick[:game] %>
          <% next unless game %>
          <% is_correct = pick[:correct] %>
          <% is_completed = pick[:winning_team_id].present? %>
          <% selected_team = [game[:away_team], game[:home_team]].find { |t| t[:id] == pick[:selected_team_id] } %>

          <div class="px-3 sm:px-4 py-3 <%= is_correct ? 'bg-green-50' : (is_completed ? 'bg-red-50' : '') %>">
            <!-- Time and Status Row -->
            <div class="flex items-center justify-between mb-2">
              <div class="text-xs text-gray-500">
                <%= game[:date].strftime("%a %l:%M %p") %>
              </div>
              <div class="flex items-center gap-1.5">
                <!-- Game Status -->
                <% if game[:status] == "STATUS_FINAL" %>
                  <span class="px-1.5 py-0.5 bg-gray-600 text-white text-xs font-medium rounded">Final</span>
                <% elsif game[:status] == "STATUS_IN_PROGRESS" %>
                  <span class="px-1.5 py-0.5 bg-blue-600 text-white text-xs font-medium rounded">
                    <%= game[:status_detail] %>
                  </span>
                <% end %>

                <!-- Result Badge -->
                <% if is_completed %>
                  <% if is_correct %>
                    <span class="px-1.5 py-0.5 bg-green-600 text-white text-xs font-semibold rounded">✓</span>
                  <% else %>
                    <span class="px-1.5 py-0.5 bg-red-600 text-white text-xs font-semibold rounded">✗</span>
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Scoreboard Row -->
            <div class="flex items-center gap-3">
              <!-- Away Team -->
              <div class="flex-1 flex items-center gap-1.5 justify-end">
                <!-- Win indicator -->
                <% if pick[:winning_team_id] == game[:away_team][:id] %>
                  <span class="text-green-600 text-sm flex-shrink-0">✓</span>
                <% end %>
                <% if pick[:selected_team_id] == game[:away_team][:id] %>
                  <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded flex items-center gap-1.5">
                    <img src="<%= game[:away_team][:logo] %>" alt="<%= game[:away_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
                    <span class="text-sm font-semibold"><%= game[:away_team][:abbreviation] %></span>
                    <% if game[:away_team][:score] %>
                      <span class="text-base font-bold"><%= game[:away_team][:score] %></span>
                    <% end %>
                  </span>
                <% else %>
                  <img src="<%= game[:away_team][:logo] %>" alt="<%= game[:away_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
                  <span class="text-sm font-medium text-gray-900"><%= game[:away_team][:abbreviation] %></span>
                  <% if game[:away_team][:score] %>
                    <span class="text-base font-bold text-gray-900"><%= game[:away_team][:score] %></span>
                  <% end %>
                <% end %>
              </div>

              <!-- Divider -->
              <div class="flex-shrink-0">
                <span class="text-gray-400 text-xs font-medium">@</span>
              </div>

              <!-- Home Team -->
              <div class="flex-1 flex items-center gap-1.5 justify-start">
                <% if pick[:selected_team_id] == game[:home_team][:id] %>
                  <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded flex items-center gap-1.5">
                    <% if game[:home_team][:score] %>
                      <span class="text-base font-bold"><%= game[:home_team][:score] %></span>
                    <% end %>
                    <span class="text-sm font-semibold"><%= game[:home_team][:abbreviation] %></span>
                    <img src="<%= game[:home_team][:logo] %>" alt="<%= game[:home_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
                  </span>
                <% else %>
                  <% if game[:home_team][:score] %>
                    <span class="text-base font-bold text-gray-900"><%= game[:home_team][:score] %></span>
                  <% end %>
                  <span class="text-sm font-medium text-gray-900"><%= game[:home_team][:abbreviation] %></span>
                  <img src="<%= game[:home_team][:logo] %>" alt="<%= game[:home_team][:abbreviation] %>" class="w-8 h-8 flex-shrink-0">
                <% end %>
                <!-- Win indicator -->
                <% if pick[:winning_team_id] == game[:home_team][:id] %>
                  <span class="text-green-600 text-sm flex-shrink-0">✓</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Actions -->
    <div>
      <%= link_to "← Back to All Submissions", admin_submissions_path(week: @week), class: "block w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors text-center" %>
    </div>
  </div>
</div>
