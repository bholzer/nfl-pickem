<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
    <!-- Header -->
    <div class="mb-4 sm:mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">All Submissions</h1>
      <p class="text-sm text-gray-600 mt-1">Admin • Week <%= @week %></p>
    </div>

    <!-- Week Selector -->
    <div class="bg-white border border-gray-200 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Select Week</h2>
      <div class="flex gap-1.5 sm:gap-2 flex-wrap">
        <% (1..18).each do |w| %>
          <%= link_to w, admin_submissions_path(week: w),
              class: "px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm font-medium rounded #{w == @week.to_i ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'} transition-colors" %>
        <% end %>
      </div>
    </div>

    <% if @submissions.any? %>
      <!-- Submissions List -->
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-4 sm:mb-6">
        <div class="divide-y divide-gray-100">
          <% @submissions.each do |submission| %>
            <% breakdown = @scoring.breakdown(submission) %>
            <div class="flex items-center justify-between px-3 sm:px-4 py-3 hover:bg-gray-50 transition-colors duration-150">
              <div class="flex-1 min-w-0">
                <p class="text-sm sm:text-base font-semibold text-gray-900 truncate"><%= submission.user.discord_username %></p>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                  TB: <%= submission.tiebreaker %> • <%= submission.created_at.strftime("%b %d at %I:%M %p") %>
                </p>
              </div>
              <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0 ml-2">
                <div class="text-right">
                  <p class="text-lg sm:text-xl font-bold text-green-600"><%= breakdown[:correct_picks] %></p>
                  <p class="text-xs text-gray-500">picks</p>
                </div>
                <%= link_to "View", admin_submission_path(submission), class: "px-3 py-1.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 sm:p-4 text-center mb-4 sm:mb-6">
        <p class="text-sm text-amber-800">No submissions found for Week <%= @week %></p>
      </div>
    <% end %>

    <!-- Quick Links -->
    <div class="space-y-2 sm:space-y-3">
      <%= link_to "Admin Dashboard", admin_jobs_path, class: "block w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors text-center" %>
      <%= link_to "Public Standings", root_path, class: "block w-full px-4 py-2.5 bg-white text-gray-700 text-sm font-medium border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors text-center" %>
    </div>
  </div>
</div>
