<div class="py-8">
  <div class="max-w-6xl mx-auto px-4">
    <div class="bg-white rounded-lg shadow-xl p-6 sm:p-8 mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-gray-800 text-center">Admin Dashboard</h1>
      <p class="text-xl text-gray-600 text-center">Job Management & System Control</p>
    </div>

    <% if notice %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
        <%= alert %>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow-xl p-6 mb-6">
      <h2 class="text-2xl font-bold mb-4 text-gray-800">Quick Actions</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <% @available_jobs.each do |job_type, config| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-500 transition-colors">
            <h3 class="font-bold text-lg mb-2"><%= config[:name] %></h3>
            <p class="text-gray-600 text-sm mb-4"><%= config[:description] %></p>

            <%= form_with url: admin_jobs_path, method: :post, class: "flex gap-2" do |f| %>
              <%= f.hidden_field :job_type, value: job_type %>
              <% if config[:requires_week] %>
                <%= f.number_field :week, value: EspnScoreboard.current_week, min: 1, max: 18, class: "px-3 py-2 border rounded-lg w-20" %>
              <% end %>
              <%= f.submit "Run Now", class: "flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-xl p-6 mb-6">
      <h2 class="text-2xl font-bold mb-4 text-gray-800">Recent Jobs</h2>
      <% if @recent_jobs.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-800 text-white">
              <tr>
                <th class="px-4 py-3 text-left">Job Class</th>
                <th class="px-4 py-3 text-left">Status</th>
                <th class="px-4 py-3 text-left">Queue</th>
                <th class="px-4 py-3 text-left">Created At</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @recent_jobs.each do |job| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-mono text-sm"><%= job.class_name %></td>
                  <td class="px-4 py-3">
                    <% if job.finished_at %>
                      <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-semibold">Finished</span>
                    <% elsif job.failed_at %>
                      <span class="px-2 py-1 bg-red-100 text-red-800 rounded text-xs font-semibold">Failed</span>
                    <% else %>
                      <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded text-xs font-semibold">Pending</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-gray-600 text-sm"><%= job.queue_name %></td>
                  <td class="px-4 py-3 text-gray-500 text-sm"><%= job.created_at.strftime("%b %d, %Y at %I:%M %p") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="bg-gray-100 rounded p-4 text-center text-gray-600">
          No recent jobs found
        </div>
      <% end %>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="bg-white rounded-lg shadow-xl p-6">
        <%= link_to "View All Submissions", admin_submissions_path, class: "block w-full py-4 bg-gradient-to-r from-purple-500 to-purple-600 text-white font-bold text-lg rounded-lg hover:from-purple-600 hover:to-purple-700 transition-all transform hover:scale-105 text-center" %>
      </div>
      <div class="bg-white rounded-lg shadow-xl p-6">
        <%= link_to "Mission Control", admin_mission_control_path, class: "block w-full py-4 bg-gradient-to-r from-indigo-500 to-blue-600 text-white font-bold text-lg rounded-lg hover:from-indigo-600 hover:to-blue-700 transition-all transform hover:scale-105 text-center" %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-xl p-6 mt-6">
      <%= link_to "← Back to Standings", root_path, class: "block w-full py-4 bg-gradient-to-r from-gray-500 to-gray-600 text-white font-bold text-lg rounded-lg hover:from-gray-600 hover:to-gray-700 transition-all transform hover:scale-105 text-center" %>
    </div>
  </div>
</div>
