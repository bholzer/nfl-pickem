<nav class="bg-gray-800 shadow-lg" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <!-- Logo/Brand -->
      <div class="flex-shrink-0 flex items-center">
        <%= link_to root_path, class: "flex items-center" do %>
          <span class="text-white text-xl font-bold">NFL Pick'em</span>
        <% end %>
      </div>

      <!-- Desktop Navigation (Right Side) -->
      <div class="hidden md:flex md:items-center md:space-x-4">
        <%= link_to "Standings", root_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium inline-flex items-center" %>

        <% if current_user %>
          <%= link_to "My Picks", submissions_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium inline-flex items-center" %>
        <% end %>

        <% if current_user&.admin? %>
          <!-- Admin Dropdown -->
          <div class="relative" data-controller="dropdown">
            <button type="button" data-action="click->dropdown#toggle" class="text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium inline-flex items-center">
              Admin
              <svg class="ml-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
              <div class="py-1">
                <%= link_to "View All Submissions", admin_submissions_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Job Dashboard", admin_jobs_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                <%= link_to "Mission Control", mission_control_jobs_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- User Info -->
        <% if current_user %>
          <div class="flex items-center pl-4 border-l border-gray-700">
            <span class="text-gray-300 text-sm">
              <%= current_user.discord_username %>
              <% if current_user.admin? %>
                <span class="ml-2 px-2 py-1 bg-yellow-500 text-gray-900 text-xs font-bold rounded">ADMIN</span>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button type="button" data-action="click->mobile-menu#toggle" class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-white hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white">
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger icon -->
          <svg data-mobile-menu-target="icon" class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg data-mobile-menu-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div data-mobile-menu-target="menu" class="hidden md:hidden">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <%= link_to "Standings", root_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium" %>

      <% if current_user %>
        <%= link_to "My Picks", submissions_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium" %>
      <% end %>

      <% if current_user&.admin? %>
        <div class="border-t border-gray-700 pt-2 mt-2">
          <div class="px-3 py-2 text-gray-400 text-xs font-semibold uppercase tracking-wider">Admin</div>
          <%= link_to "View All Submissions", admin_submissions_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium" %>
          <%= link_to "Job Dashboard", admin_jobs_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium" %>
          <%= link_to "Mission Control", mission_control_jobs_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium" %>
        </div>
      <% end %>
    </div>

    <!-- User info in mobile menu -->
    <% if current_user %>
      <div class="pt-4 pb-3 border-t border-gray-700">
        <div class="px-5">
          <div class="text-sm font-medium text-gray-400">Signed in as</div>
          <div class="text-base font-medium text-white flex items-center">
            <%= current_user.discord_username %>
            <% if current_user.admin? %>
              <span class="ml-2 px-2 py-1 bg-yellow-500 text-gray-900 text-xs font-bold rounded">ADMIN</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</nav>
