<!-- Week Selector -->
<div class="bg-white border border-gray-200 rounded-lg p-3 sm:p-4 mb-4 sm:mb-6">
  <h2 class="text-sm font-semibold text-gray-900 mb-2 text-center">Select Week</h2>
  <div class="flex gap-1.5 sm:gap-2 flex-wrap justify-center">
    <% (1..18).each do |w| %>
      <%= link_to w, url_for(week: w),
          class: "px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm font-medium rounded #{w == current_week.to_i ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'} transition-colors" %>
    <% end %>
  </div>
</div>
