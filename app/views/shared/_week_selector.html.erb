<!-- Week Selector -->
<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg p-3 sm:p-4 mt-4 sm:mt-6 mb-4 sm:mb-6">
  <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2 text-center">Select Week</h2>
  <div class="flex gap-1.5 sm:gap-2 flex-wrap justify-center">
    <% (1..18).each do |w| %>
      <%= link_to w, url_for(week: w),
          class: "px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm font-medium rounded #{w == current_week.to_i ? 'bg-blue-600 dark:bg-blue-700 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'} transition-colors" %>
    <% end %>
  </div>
</div>
