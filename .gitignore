# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`


# Environment files at any depth, including environment-specific overrides.
.env*

# Local data, logs, and temporary browser artifacts.
/log/
/tmp/
/storage/
/backups/
/snapshots/
/exports/
/private/
*.log

# Database files and ad-hoc SQL exports; schema migrations remain versioned.
*.sqlite*
*.db
*.db-*
*.db3*
*.sql
!/migrations/*.sql
*.dump
*.bak
*.backup

# Private keys, including restored credential backups.
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ecdsa
id_ed25519

# Private deployment bundles and restored legacy credentials.
*-secrets.json
cloudflare-api-token*
.npmrc
/.kamal/secrets*
/config/credentials*



# Cloudflare / npm application tooling.
node_modules/
/dist/
.wrangler/
.dev.vars*
!.dev.vars.example
/coverage/
/playwright-report/
/test-results/
/blob-report/
*.tsbuildinfo

# Machine-local editor and assistant settings.
.DS_Store
/.claude/settings.local.json


# Terraform working files; environment state is stored privately outside the repo.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
