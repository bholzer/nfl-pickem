{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest*.ts",
    "playwright.config.ts",
    "*.mjs",
    "scripts",
    "tests/e2e",
    "tests/unit",
    "tests/setup-network.ts"
  ]
}
